{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		"types": ["$app/types", "node", "unplugin-icons/types/svelte"]
	},
	"include": [
		"src",
		"scripts/**/*.test.ts",
		"test/templates/**/*.ts",
		"vite.config.ts",
		"vitest*.config.ts"
	],
	"exclude": [
		"node_modules",
		"build",
		"src/lib/pieces/components/custom",
		"src/lib/content/components/custom",
		"src/service-worker.js",
		"src/service-worker.ts",
		"src/service-worker.d.ts",
		"src/service-worker"
	]
}
