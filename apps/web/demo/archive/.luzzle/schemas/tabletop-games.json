{
  "title": "tabletop-games",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "examples": ["The Lantern Market"]
    },
    "summary": {
      "type": "string",
      "format": "paragraph"
    },
    "publisher": {
      "type": "string"
    },
    "player_count": {
      "type": "integer",
      "examples": [2],
      "minimum": 1
    },
    "play_time_minutes": {
      "type": "integer",
      "minimum": 0
    },
    "date_published": {
      "type": "string",
      "format": "date"
    },
    "date_played": {
      "type": "string",
      "format": "date"
    },
    "url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "cover": {
      "type": "string",
      "format": "asset"
    },
    "keywords": {
      "type": "string",
      "format": "comma-separated"
    }
  },
  "required": ["title", "player_count"],
  "additionalProperties": true
}
