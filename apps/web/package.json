{
  "name": "@luzzle/web",
  "version": "0.0.244",
  "private": true,
  "files": [
    "build",
    "scripts/start-server.js",
    "scripts/runtime-environment.js"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm run sync:svelte && vite build",
    "preview": "vite preview",
    "check": "pnpm run sync:svelte && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "pnpm run sync:svelte && svelte-check --tsconfig ./tsconfig.json --watch",
    "sync:svelte": "svelte-kit sync",
    "lint": "prettier --check . && prettier --config .prettierrc --check '../../packages/web/templates/src/**/*.svelte' && eslint .",
    "format": "prettier --write .",
    "test": "vitest run --silent",
    "test:templates": "vitest run --config vitest.templates.config.ts --silent"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eleith/luzzle.git"
  },
