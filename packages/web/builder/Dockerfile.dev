FROM node:24-slim AS builder
WORKDIR /local

COPY --from=core . /local/core
COPY --from=utils . /local/utils
COPY --from=tools . /local/tools

RUN cd /local/core && npm install && npm run build
RUN cd /local/utils && npm install && npm run build
RUN cd /local/tools && \
    npm pkg set 'dependencies[@luzzle/core]'=file:/local/core && \
    npm pkg set 'dependencies[@luzzle/web.utils]'=file:/local/utils && \
    npm install && npm run build

FROM node:24-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    curl \
    unzip \
    wget \
    gnupg \
    ca-certificates \
    fonts-liberation \
    libnss3 \
    libnspr4 \
    libgbm1 \
    libasound2 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxkbcommon0 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdrm2 \
    libexpat1 \
    libpango-1.0-0 \
    && curl -O https://downloads.rclone.org/rclone-current-linux-amd64.zip \
    && unzip rclone-current-linux-amd64.zip \
    && cp rclone-*-linux-amd64/rclone /usr/bin/ \
    && chown root:root /usr/bin/rclone \
    && chmod 755 /usr/bin/rclone \
    && rm -rf rclone-* \
    && rm -rf /var/lib/apt/lists/*

RUN npx @puppeteer/browsers install chrome-headless-shell@stable --path /opt/chrome && \
    ln -s $(find /opt/chrome/chrome-headless-shell -name chrome-headless-shell -type f | head -n 1) /usr/bin/chrome-headless-shell

ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chrome-headless-shell

COPY --from=builder /local/tools/package.json /local/tools/package.json
COPY --from=builder /local/tools/dist /local/tools/dist
COPY --from=builder /local/tools/node_modules /local/tools/node_modules
COPY --from=builder /local/core/package.json /local/core/package.json
COPY --from=builder /local/core/dist /local/core/dist
COPY --from=builder /local/core/node_modules /local/core/node_modules
COPY --from=builder /local/utils/package.json /local/utils/package.json
COPY --from=builder /local/utils/dist /local/utils/dist
COPY --from=builder /local/utils/node_modules /local/utils/node_modules

RUN npm install -g /local/tools && npm cache clean --force

RUN mkdir -p /app/scripts /app/data /app/archive /app/assets /app/rclone && \
    chgrp 0 /app /app/scripts /app/data /app/archive /app/assets /app/rclone && \
    chmod g+w /app /app/scripts /app/data /app/archive /app/assets /app/rclone

COPY --chown=:0 --chmod=775 ./server.js /app/server.js
COPY --chown=:0 --chmod=775 ./scripts/*.sh /app/scripts/

EXPOSE 9000

CMD ["node", "/app/server.js"]
