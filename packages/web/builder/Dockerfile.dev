FROM node:24-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    curl \
    rclone \
    wget \
    gnupg \
    ca-certificates \
    fonts-liberation \
    libnss3 \
    libnspr4 \
    libgbm1 \
    libasound2 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxkbcommon0 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdrm2 \
    libexpat1 \
    libpango-1.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN npx @puppeteer/browsers install chrome-headless-shell@stable --path /opt/chrome && \
    ln -s $(find /opt/chrome/chrome-headless-shell -name chrome-headless-shell -type f | head -n 1) /usr/bin/chrome-headless-shell

ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chrome-headless-shell

COPY --from=core . /local/core
COPY --from=utils . /local/utils
COPY --from=tools . /local/tools

RUN cd /local/tools && \
    npm pkg set 'dependencies[@luzzle/core]'=file:/local/core && \
    npm pkg set 'dependencies[@luzzle/web.utils]'=file:/local/utils

RUN cd /local/core && rm -rf node_modules && npm install && npm run build
RUN cd /local/utils && rm -rf node_modules && npm install && npm run build
RUN cd /local/tools && rm -rf node_modules && npm install && npm run build

RUN npm install -g /local/tools && npm cache clean --force

RUN mkdir -p /app/scripts /app/data /app/archive /app/assets && \
    chgrp 0 /app /app/scripts /app/data /app/archive /app/assets && \
    chmod g+w /app /app/scripts /app/data /app/archive /app/assets

COPY --chown=:0 ./server.js /app/server.js
COPY --chown=:0 ./scripts/pre.build.sh /app/scripts/pre.build.sh
COPY --chown=:0 ./scripts/build.sh /app/scripts/build.sh
COPY --chown=:0 ./scripts/post.build.sh /app/scripts/post.build.sh
COPY --chown=:0 ./scripts/pre.deploy.sh /app/scripts/pre.deploy.sh
COPY --chown=:0 ./scripts/deploy.sh /app/scripts/deploy.sh
COPY --chown=:0 ./scripts/post.deploy.sh /app/scripts/post.deploy.sh

RUN chmod g+w /app/server.js /app/scripts/*.sh

EXPOSE 9000

CMD ["node", "/app/server.js"]
