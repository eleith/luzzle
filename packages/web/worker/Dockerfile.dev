FROM node:24-slim AS builder
WORKDIR /m

COPY package.json package-lock.json ./
COPY packages/ packages/

RUN npm ci --workspaces && npm run build --workspace=@luzzle/core --workspace=@luzzle/web.config

FROM node:24-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    curl \
    unzip \
    ca-certificates \
    && curl -O https://downloads.rclone.org/rclone-current-linux-amd64.zip \
    && unzip rclone-current-linux-amd64.zip \
    && cp rclone-*-linux-amd64/rclone /usr/bin/ \
    && chown root:root /usr/bin/rclone \
    && chmod 755 /usr/bin/rclone \
    && rm -rf rclone-* \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /app/queue /app/archive /app/assets /app/rclone /app/dist && \
    chgrp 0 /app /app/queue /app/archive /app/assets /app/rclone && \
    chmod g+w /app /app/queue /app/archive /app/assets /app/rclone && \
    chmod -R 777 /app/dist

COPY --from=builder --chown=:0 --chmod=775 /m/node_modules /app/node_modules
COPY --from=builder --chown=:0 --chmod=775 /m/packages /app/packages

COPY --chown=:0 --chmod=775 packages/web/worker/package.json /app/package.json
COPY --chown=:0 --chmod=775 packages/web/worker/tsconfig.json /app/tsconfig.json
COPY --chown=:0 --chmod=775 packages/web/worker/tsconfig.build.json /app/tsconfig.build.json
COPY --chown=:0 --chmod=775 packages/web/worker/src /app/src

EXPOSE 9000

CMD ["sh", "-c", "npm run build && mkdir -p /app/dist/src/pieces/.compiled && chmod 777 /app/dist/src/pieces/.compiled && node /app/dist/src/index.js"]
