FROM node:24-slim AS builder
WORKDIR /local

COPY --from=core . /local/core
COPY --from=config . /local/config
COPY package.json tsconfig.json ./
COPY src ./src

RUN cd /local/core && npm install && npm run build
RUN cd /local/config && npm install && npm run build
RUN npm pkg set 'dependencies[@luzzle/core]'=file:/local/core && \
    npm pkg set 'dependencies[@luzzle/web.config]'=file:/local/config && \
    npm install && npm run build

FROM node:24-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    curl \
    unzip \
    wget \
    gnupg \
    ca-certificates \
    fonts-liberation \
    libnss3 \
    libnspr4 \
    libgbm1 \
    libasound2 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxkbcommon0 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdrm2 \
    libexpat1 \
    libpango-1.0-0 \
    && curl -O https://downloads.rclone.org/rclone-current-linux-amd64.zip \
    && unzip rclone-current-linux-amd64.zip \
    && cp rclone-*-linux-amd64/rclone /usr/bin/ \
    && chown root:root /usr/bin/rclone \
    && chmod 755 /usr/bin/rclone \
    && rm -rf rclone-* \
    && rm -rf /var/lib/apt/lists/*

RUN npx @puppeteer/browsers install chrome-headless-shell@stable --path /opt/chrome && \
    ln -s $(find /opt/chrome/chrome-headless-shell -name chrome-headless-shell -type f | head -n 1) /usr/bin/chrome-headless-shell

ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chrome-headless-shell

RUN mkdir -p /app/queue /app/archive /app/assets /app/rclone && \
    chgrp 0 /app /app/queue /app/archive /app/assets /app/rclone && \
    chmod g+w /app /app/queue /app/archive /app/assets /app/rclone

COPY --from=builder --chown=:0 --chmod=775 /local/dist /app/dist
COPY --from=builder --chown=:0 --chmod=775 /local/node_modules /app/node_modules
COPY --from=builder --chown=:0 --chmod=775 /local/package.json /app/package.json

COPY --from=builder --chown=:0 --chmod=775 /local/core/package.json /app/core/package.json
COPY --from=builder --chown=:0 --chmod=775 /local/core/dist /app/core/dist
COPY --from=builder --chown=:0 --chmod=775 /local/core/node_modules /app/core/node_modules
COPY --from=builder --chown=:0 --chmod=775 /local/config/package.json /app/config/package.json
COPY --from=builder --chown=:0 --chmod=775 /local/config/dist /app/config/dist
COPY --from=builder --chown=:0 --chmod=775 /local/config/node_modules /app/config/node_modules

# Dev: recompile from bind-mounted /app/src on every container start so a
# stop/start picks up the latest code without a full image rebuild. 777 is
# needed because compose runs as ${UID:-1000}:${GID:-1000}, which isn't in
# group 0 and so can't write to the existing g+w dist.
RUN chmod -R 777 /app/dist

EXPOSE 9000

CMD ["sh", "-c", "npx tsc && node /app/dist/src/index.js"]