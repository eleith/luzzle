pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path       /tmp/proxy_temp_path;
    fastcgi_temp_path     /tmp/fastcgi_temp;
    uwsgi_temp_path       /tmp/uwsgi_temp;
    scgi_temp_path        /tmp/scgi_temp;

    include       mime.types;
    default_type  application/octet-stream;

    access_log  /dev/stdout;
    error_log   /dev/stderr;

    sendfile            on;
    keepalive_timeout   65;
    gzip                on;
    gzip_types          text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    upstream luzzle-upstream {
        server ${LUZZLE_EXPLORER_HOST}:${LUZZLE_EXPLORER_PORT};
        keepalive 2;
    }

    proxy_cache_path        /app/cache levels=1:2 keys_zone=luzzle_cache:10m inactive=365d max_size=10g;
    proxy_buffer_size       128k;
    proxy_buffers           4 256k;
    proxy_busy_buffers_size 256k;

    server {
        listen 8080;
        server_name localhost;

        client_max_body_size 256M;
        
        # Shared Proxy & Cache Headers
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

        # Default Cache Settings (Inherited by locations)
        proxy_cache             luzzle_cache;
        proxy_cache_revalidate  on;
        proxy_cache_min_uses    1;
        proxy_cache_lock        on;
        proxy_cache_valid       200 302 365d;
        proxy_cache_valid       404 365d;
        proxy_cache_key         "$scheme$request_method$proxy_host$request_uri";

        add_header X-Cache-Status $upstream_cache_status;
        add_header Strict-Transport-Security "max-age=31536001; includeSubdomains" always;

        # 1. Cacheable Paths (Root, Pieces, RSS, Search)
        location ~* "^/(?:pieces|rss|search|$)" {
            proxy_pass http://luzzle-upstream;
        }

        # 2. Cacheable Extensions (Assets)
        location ~* "\.(?:txt|jpg|jpeg|png|webp|avif|css)$" {
            proxy_pass http://luzzle-upstream;
        }

        # 3. Non-Cacheable Build API (Streaming)
        location /api/build {
            proxy_cache     off;
            proxy_buffering off;
            add_header      X-Accel-Buffering "no" always;
            proxy_pass      http://luzzle-upstream;
        }

        # 4. Fallback for everything else (No Cache)
        location / {
            proxy_cache     off;
            proxy_pass      http://luzzle-upstream;
        }
    }
}
