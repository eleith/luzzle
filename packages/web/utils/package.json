{
	"name": "@luzzle/web.utils",
	"version": "0.0.33",
	"author": "eleith",
	"scripts": {
		"lint": "eslint src",
		"build": "tsc",
		"test": "vitest run --silent --coverage"
	},
	"engines": {
		"node": ">=24"
	},
	"files": [
		"dist/*",
		"package.json"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/eleith/luzzle.git"
	},
	"homepage": "https://github.com/eleith/luzzle",
	"description": "misc scripts for working with luzzle related files and projects",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"import": "./dist/src/index.js"
		},
		"./server": {
			"types": "./dist/src/server.d.ts",
			"import": "./dist/src/server.js"
		}
	},
	"dependencies": {
		"@luzzle/web.config": "0.0.2"
	},
	"devDependencies": {
		"@types/eslint": "9.6.1",
		"@types/node": "22.12.0",
		"@types/yargs": "17.0.13",
		"@vitest/coverage-v8": "3.2.4",
		"eslint": "9.22.0",
		"eslint-config-prettier": "9.1.0",
		"eslint-plugin-prettier": "5.2.1",
		"globals": "16.0.0",
		"prettier": "3.2.5",
		"typescript": "5.7.3",
		"typescript-eslint": "8.19.1",
		"vite": "7.1.7",
		"vitest": "3.2.4"
	},
	"type": "module"
}
