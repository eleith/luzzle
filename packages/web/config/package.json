{
	"name": "@luzzle/web.config",
	"version": "0.0.5",
	"private": true,
	"author": "eleith",
	"scripts": {
		"lint": "eslint src",
		"build:assets": "cp src/lib/config/web.config.schema.json dist/src/lib/config/",
		"build:external-schema": "node scripts/generate-external-schema.js",
		"check:schemas": "node scripts/generate-external-schema.js --check",
		"prebuild": "npm run build:external-schema && rm -rf dist",
		"postbuild": "npm run build:assets",
		"build": "tsc -p tsconfig.build.json",
		"test": "node scripts/generate-external-schema.js --check && vitest run --silent --coverage"
	},
	"engines": {
		"node": ">=24"
	},
	"files": [
		"dist/*",
		"package.json"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/eleith/luzzle.git"
	},
	"homepage": "https://github.com/eleith/luzzle",
	"description": "shared configuration and schemas for the luzzle web ecosystem",
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/src/index.d.ts",
			"import": "./dist/src/index.js"
		}
	},
	"devDependencies": {
		"@eslint/js": "catalog:",
		"@types/eslint": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"eslint-plugin-prettier": "5.2.1",
		"globals": "catalog:",
		"prettier": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"dependencies": {
		"@sinclair/typebox": "0.34.49",
		"yaml": "2.7.0"
	},
	"type": "module"
}
