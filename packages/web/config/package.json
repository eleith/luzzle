{
	"name": "@luzzle/web.config",
	"version": "0.0.3",
	"private": true,
	"author": "eleith",
	"scripts": {
		"lint": "eslint src",
		"build:assets": "cp -r ./src/lib/config ./dist/src/lib",
		"build:external-schema": "node scripts/generate-external-schema.js > src/lib/config/web.config.schema.json",
		"build:types": "json2ts --input src/lib/config/schema.json --output src/lib/config/schema.ts",
		"prebuild": "npm run build:external-schema && npm run build:types",
		"postbuild": "npm run build:assets",
		"build": "tsc",
		"test": "vitest run --silent --coverage"
	},
	"engines": {
		"node": ">=24"
	},
	"files": [
		"dist/*",
		"package.json"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/eleith/luzzle.git"
	},
	"homepage": "https://github.com/eleith/luzzle",
	"description": "shared configuration and schemas for the luzzle web ecosystem",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"import": "./dist/src/index.js"
		}
	},
	"devDependencies": {
		"@eslint/js": "catalog:",
		"@types/eslint": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"eslint-plugin-prettier": "5.2.1",
		"globals": "catalog:",
		"json-schema-to-typescript": "15.0.4",
		"prettier": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"dependencies": {
		"ajv": "8.17.1",
		"yaml": "^2.7.0"
	},
	"type": "module"
}
