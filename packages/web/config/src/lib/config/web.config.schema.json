{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Luzzle web configuration",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "network": {
      "default": {},
      "description": "Internal service and development network settings.",
      "type": "object",
      "properties": {
        "internal": {
          "default": {},
          "type": "object",
          "properties": {
            "explorer": {
              "default": "http://luzzle-web:3000",
              "description": "Explorer address used to allow its hostname in the development server.",
              "type": "string"
            },
            "lsp": {
              "default": "http://luzzle-lsp:9001",
              "description": "Reserved LSP address. Proxy routing is configured separately with LUZZLE_PROXY_LSP_UPSTREAM.",
              "type": "string"
            },
            "worker": {
              "default": "http://luzzle-worker:9000",
              "description": "Worker service address for health checks.",
              "type": "string"
            }
          }
        },
        "public": {
          "default": {},
          "type": "object",
          "properties": {
            "host": {
              "default": "0.0.0.0",
              "description": "Development server bind address, not the public site URL.",
              "type": "string"
            },
            "hmr_port": {
              "description": "Vite hot-reload client port, when different from the server port.",
              "type": "number"
            }
          }
        }
      }
    },
    "url": {
      "default": {},
      "additionalProperties": false,
      "description": "Public site and asset URLs.",
      "type": "object",
      "properties": {
        "app": {
          "default": "${LUZZLE_APP_URL:-http://localhost:8080}",
          "description": "Public Explorer URL. Supports an explicit environment reference.",
          "type": "string"
        },
        "app_assets": {
          "default": "",
          "description": "Application asset base URL. Empty uses same-origin paths; a CDN URL is allowed.",
          "type": "string"
        },
        "luzzle_assets": {
          "default": "",
          "description": "Published piece asset base URL. Empty uses same-origin paths; a CDN URL is allowed.",
          "type": "string"
        }
      }
    },
    "auth": {
      "description": "Configure exactly one authentication provider and a session secret. Omit auth for a public-only site with admin access disabled.",
      "anyOf": [
        {
          "title": "Credentials",
          "additionalProperties": false,
          "type": "object",
          "required": [
            "secret",
            "credentials"
          ],
          "properties": {
            "secret": {
              "minLength": 1,
              "description": "Session-signing secret. Supply a strong random value or an explicit environment reference; required whenever auth is configured.",
              "examples": [
                "${LUZZLE_AUTH_SECRET}"
              ],
              "type": "string"
            },
            "credentials": {
              "additionalProperties": false,
              "description": "Local username/password authentication.",
              "type": "object",
              "required": [
                "username",
                "password"
              ],
              "properties": {
                "username": {
                  "minLength": 1,
                  "description": "Administrator username.",
                  "examples": [
                    "admin"
                  ],
                  "type": "string"
                },
                "password": {
                  "minLength": 1,
                  "description": "Administrator password or an explicit environment reference.",
                  "examples": [
                    "${LUZZLE_AUTH_PASSWORD}"
                  ],
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "title": "OIDC",
          "additionalProperties": false,
          "type": "object",
          "required": [
            "secret",
            "oidc"
          ],
          "properties": {
            "secret": {
              "minLength": 1,
              "description": "Session-signing secret. Supply a strong random value or an explicit environment reference; required whenever auth is configured.",
              "examples": [
                "${LUZZLE_AUTH_SECRET}"
              ],
              "type": "string"
            },
            "oidc": {
              "additionalProperties": false,
              "description": "OpenID Connect authentication.",
              "type": "object",
              "required": [
                "issuer",
                "clientId",
                "clientSecret"
              ],
              "properties": {
                "name": {
                  "default": "Single Sign-On",
                  "description": "Label shown on the sign-in button.",
                  "type": "string"
                },
                "issuer": {
                  "minLength": 1,
                  "description": "OIDC issuer URL or an explicit environment reference.",
                  "examples": [
                    "https://identity.example.com",
                    "${OIDC_ISSUER}"
                  ],
                  "type": "string"
                },
                "clientId": {
                  "minLength": 1,
                  "description": "OIDC client identifier.",
                  "type": "string"
                },
                "clientSecret": {
                  "minLength": 1,
                  "description": "OIDC client secret or an explicit environment reference.",
                  "examples": [
                    "${OIDC_CLIENT_SECRET}"
                  ],
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "storage": {
      "default": {},
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "root": {
          "minLength": 1,
          "default": "./archive",
          "description": "Local Markdown archive directory.",
          "type": "string"
        }
      }
    },
    "sync": {
      "default": {},
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "config": {
          "default": "/app/rclone/rclone.conf",
          "description": "rclone configuration file used by the worker.",
          "type": "string"
        },
        "archive": {
          "default": {},
          "additionalProperties": false,
          "description": "Bidirectional archive synchronization using rclone bisync.",
          "type": "object",
          "properties": {
            "remote": {
              "default": "",
              "description": "rclone remote name, not an s3:// URL. Empty remote or path skips archive synchronization.",
              "type": "string"
            },
            "path": {
              "default": "",
              "description": "Remote archive path, combined with the remote name as remote:path.",
              "type": "string"
            },
            "flags": {
              "default": [],
              "description": "Additional rclone arguments, one argument per array entry.",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "cdn": {
          "default": {},
          "additionalProperties": false,
          "description": "Publish generated assets to a remote destination.",
          "type": "object",
          "properties": {
            "remote": {
              "default": "",
              "description": "rclone remote name. Empty remote or path skips CDN synchronization.",
              "type": "string"
            },
            "path": {
              "default": "",
              "description": "Remote published-assets path, combined as remote:path.",
              "type": "string"
            },
            "flags": {
              "default": [],
              "description": "Additional rclone arguments, one argument per array entry.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "strategy": {
              "default": "sync",
              "description": "sync deletes destination-only files; copy does not.",
              "anyOf": [
                {
                  "const": "sync",
                  "type": "string"
                },
                {
                  "const": "copy",
                  "type": "string"
                }
              ]
            }
          }
        }
      }
    },
    "worker": {
      "default": {},
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "queue": {
          "default": {},
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "path": {
              "default": "./data/sidequest.sqlite",
              "description": "Workflow queue database path. The legacy sidequest.sqlite filename is mapped to openworkflow.sqlite by the application.",
              "type": "string"
            }
          }
        }
      }
    },
    "ai": {
      "additionalProperties": false,
      "description": "AI generation settings. Omit ai to disable generation; both provider and api_key must be supplied when configured.",
      "type": "object",
      "required": [
        "provider",
        "api_key"
      ],
      "properties": {
        "provider": {
          "description": "Generation provider. Google is currently the supported provider; this field is required.",
          "const": "google",
          "type": "string"
        },
        "api_key": {
          "minLength": 1,
          "description": "Provider API key or an explicit environment reference.",
          "examples": [
            "${GOOGLE_API_KEY}"
          ],
          "type": "string"
        }
      }
    },
    "paths": {
      "default": {},
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "database": {
          "default": "./data/luzzle.sqlite",
          "description": "SQLite index path, resolved relative to the config directory.",
          "type": "string"
        },
        "assets": {
          "default": "./assets/pieces",
          "description": "Generated piece assets directory. Worker generation uses its working directory for relative paths.",
          "type": "string"
        },
        "cache": {
          "default": "./nginx",
          "description": "Proxy cache directory.",
          "type": "string"
        },
        "static": {
          "default": "./static",
          "description": "Static render assets directory.",
          "type": "string"
        },
        "config": {
          "description": "Runtime metadata: loadConfig records the supplied config filename here.",
          "readOnly": true,
          "type": "string"
        }
      }
    },
    "assets": {
      "default": {},
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "salt": {
          "default": "${LUZZLE_ASSET_SALT:-}",
          "description": "Salt for generated asset keys. Changing it changes published asset URLs.",
          "type": "string"
        }
      }
    },
    "content": {
      "default": {},
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "component": {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "404": {
              "description": "Svelte source path for the not-found page.",
              "type": "string"
            },
            "root": {
              "description": "Svelte source path for the home page.",
              "type": "string"
            },
            "feed": {
              "description": "Svelte source path for the feed.",
              "type": "string"
            },
            "error": {
              "description": "Svelte source path for the error page.",
              "type": "string"
            }
          }
        },
        "text": {
          "default": {},
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "title": {
              "default": "Luzzle Explorer",
              "description": "Site title.",
              "type": "string"
            },
            "description": {
              "default": "A Luzzle Explorer instance",
              "description": "Site description.",
              "type": "string"
            }
          }
        }
      }
    },
    "pieces": {
      "default": [],
      "description": "Ordered presentation and frontmatter mappings for archive piece types.",
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "fields"
        ],
        "properties": {
          "type": {
            "description": "Archive piece type associated with this presentation.",
            "examples": [
              "books"
            ],
            "type": "string"
          },
          "fields": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "title",
              "date_consumed"
            ],
            "properties": {
              "media": {
                "description": "Frontmatter selectors for media assets.",
                "examples": [
                  [
                    "cover"
                  ]
                ],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "title": {
                "description": "Frontmatter selector for the title, not a literal display title.",
                "examples": [
                  "title"
                ],
                "type": "string"
              },
              "summary": {
                "description": "Frontmatter selector for a summary.",
                "examples": [
                  "description"
                ],
                "type": "string"
              },
              "date_consumed": {
                "description": "Frontmatter selector for the consumed/read/viewed date.",
                "examples": [
                  "date_read"
                ],
                "type": "string"
              },
              "tags": {
                "description": "Frontmatter selector for tags.",
                "examples": [
                  "keywords"
                ],
                "type": "string"
              },
              "attachments": {
                "description": "Frontmatter selectors for attachments.",
                "examples": [
                  [
                    "files[*].file"
                  ]
                ],
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "components": {
            "additionalProperties": false,
            "type": "object",
            "properties": {
              "icon": {
                "description": "Svelte source path for the piece icon.",
                "type": "string"
              },
              "opengraph": {
                "description": "Svelte source path for the Open Graph image.",
                "type": "string"
              },
              "page": {
                "description": "Svelte source path for the piece page.",
                "type": "string"
              }
            }
          }
        }
      }
    },
    "theme": {
      "default": {},
      "additionalProperties": false,
      "description": "Theme overrides. Omit any defaulted tokens you do not need to customize.",
      "type": "object",
      "properties": {
        "light": {
          "default": {},
