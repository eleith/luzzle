{
	"name": "@luzzle/web.templates",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Shared template contracts and built-in sources for web and worker",
	"engines": {
		"node": ">=26"
	},
	"files": [
		"dist",
		"src/server/*.ts",
		"src/icons/default/template.svelte",
		"src/pages/default/template.svelte",
		"src/opengraphs/default/template.svelte",
		"config.schema.json"
	],
	"scripts": {
		"prebuild": "rm -rf dist",
		"build": "tsc -p tsconfig.json",
		"postbuild": "node scripts/generate-schema.js",
		"test": "node --test \"src/**/*.test.js\"",
		"lint": "eslint . && prettier --check ."
	},
	"exports": {
		"./server": {
			"types": "./dist/server/index.d.ts",
			"node": {
				"development": "./src/server/index.ts",
				"import": "./dist/server/index.js"
			}
		},
		"./icons/props": {
			"development": "./src/icons/props.ts",
			"types": "./dist/icons/props.d.ts",
			"import": "./dist/icons/props.js"
		},
		"./icons/default": "./src/icons/default/template.svelte",
		"./pages/props": {
			"development": "./src/pages/props.ts",
			"types": "./dist/pages/props.d.ts",
			"import": "./dist/pages/props.js"
		},
		"./pages/default": "./src/pages/default/template.svelte",
		"./opengraphs/props": {
			"development": "./src/opengraphs/props.ts",
			"types": "./dist/opengraphs/props.d.ts",
			"import": "./dist/opengraphs/props.js"
		},
		"./opengraphs/default": "./src/opengraphs/default/template.svelte",
		"./pieces/fields": {
			"development": "./src/pieces/fields.ts",
			"types": "./dist/pieces/fields.d.ts",
			"import": "./dist/pieces/fields.js"
		},
		"./config": {
			"development": "./src/config/index.ts",
			"types": "./dist/config/index.d.ts",
			"import": "./dist/config/index.js"
		},
		"./schema": {
			"development": "./src/config/schema.ts",
			"types": "./dist/config/schema.d.ts",
			"import": "./dist/config/schema.js"
		},
		"./icons/default/schema": {
			"development": "./src/icons/default/schema.ts",
			"types": "./dist/icons/default/schema.d.ts",
			"import": "./dist/icons/default/schema.js"
		},
		"./pages/default/schema": {
			"development": "./src/pages/default/schema.ts",
			"types": "./dist/pages/default/schema.d.ts",
			"import": "./dist/pages/default/schema.js"
		},
		"./opengraphs/default/schema": {
			"development": "./src/opengraphs/default/schema.ts",
			"types": "./dist/opengraphs/default/schema.d.ts",
			"import": "./dist/opengraphs/default/schema.js"
		},
		"./config.schema.json": "./config.schema.json",
		"./mapping": {
			"development": "./src/mapping.ts",
			"types": "./dist/mapping.d.ts",
			"import": "./dist/mapping.js"
		}
	},
	"dependencies": {
		"@luzzle/core": "workspace:*",
		"@luzzle/web.config": "workspace:*",
		"@luzzle/web.pieces": "workspace:*",
		"@sinclair/typebox": "0.34.49"
	},
	"peerDependencies": {
		"svelte": "5.57.3"
	},
	"devDependencies": {
		"@eslint/js": "catalog:",
		"@types/node": "catalog:",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"globals": "catalog:",
		"prettier": "catalog:",
		"svelte": "5.57.3",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:"
	}
}
