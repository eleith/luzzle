{
	"name": "@luzzle/web.templates",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Shared template contracts and built-in sources for web and worker",
	"engines": {
		"node": ">=24"
	},
	"files": [
		"dist",
		"src/components/*.svelte",
		"src/icons/*/template.svelte",
		"src/icons/*/helpers.js",
		"src/icons/catalog.js",
		"src/pages/*/template.svelte",
		"src/pages/*/helpers.js",
		"src/pages/catalog.js",
		"src/opengraphs/*/template.svelte",
		"src/opengraphs/catalog.js",
		"config.schema.json"
	],
	"scripts": {
		"prebuild": "rm -rf dist",
		"build": "tsc -p tsconfig.json",
		"postbuild": "node scripts/generate-schema.js",
		"test": "node --test \"src/**/*.test.js\"",
		"lint": "eslint . && prettier --check ."
	},
	"exports": {
		"./icons": "./src/icons/catalog.js",
		"./icons/*": "./src/icons/*/template.svelte",
		"./pages": "./src/pages/catalog.js",
		"./pages/*": "./src/pages/*/template.svelte",
		"./opengraphs": "./src/opengraphs/catalog.js",
		"./opengraphs/*": "./src/opengraphs/*/template.svelte",
		"./pieces/fields": {
			"development": "./src/pieces/fields.ts",
			"types": "./dist/pieces/fields.d.ts",
			"import": "./dist/pieces/fields.js"
		},
		"./config": {
			"development": "./src/config/index.ts",
			"types": "./dist/config/index.d.ts",
			"import": "./dist/config/index.js"
		},
		"./schema": {
			"development": "./src/config/schema.ts",
			"types": "./dist/config/schema.d.ts",
			"import": "./dist/config/schema.js"
		},
		"./icons/*/schema": {
			"development": "./src/icons/*/schema.ts",
			"types": "./dist/icons/*/schema.d.ts",
			"import": "./dist/icons/*/schema.js"
		},
		"./pages/*/schema": {
			"development": "./src/pages/*/schema.ts",
			"types": "./dist/pages/*/schema.d.ts",
			"import": "./dist/pages/*/schema.js"
		},
		"./opengraphs/*/schema": {
			"development": "./src/opengraphs/*/schema.ts",
			"types": "./dist/opengraphs/*/schema.d.ts",
			"import": "./dist/opengraphs/*/schema.js"
		},
		"./config.schema.json": "./config.schema.json",
		"./mapping": {
			"development": "./src/mapping.ts",
			"types": "./dist/mapping.d.ts",
			"import": "./dist/mapping.js"
		},
		"./components/*.svelte": "./src/components/*.svelte",
		"./pieces/props": {
			"types": "./dist/pieces/props.d.ts"
		},
		"./site/props": {
			"types": "./dist/site/props.d.ts"
		},
		"./components/props": {
			"types": "./dist/components/props.d.ts"
		},
		"./helpers": {
			"types": "./dist/helpers.d.ts"
		},
		"./bundle": {
			"types": "./dist/bundle.d.ts"
		}
	},
	"dependencies": {
		"@luzzle/core": "workspace:*",
		"@luzzle/web.config": "workspace:*",
		"@luzzle/web.pieces": "workspace:*",
		"@sinclair/typebox": "0.34.49"
	},
	"peerDependencies": {
		"svelte": "5.55.9"
	},
	"devDependencies": {
		"@eslint/js": "catalog:",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"globals": "catalog:",
		"prettier": "catalog:",
		"svelte": "5.55.9",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:"
	}
}
