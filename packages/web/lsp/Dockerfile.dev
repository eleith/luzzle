FROM node:24-alpine AS builder
WORKDIR /m

COPY package.json package-lock.json ./
COPY packages/ packages/

RUN npm ci --workspaces && npm run build --workspace=@luzzle/lsp

FROM node:24-alpine
WORKDIR /app

RUN npm install -g yaml-language-server

COPY --from=builder /m/node_modules ./node_modules
COPY --from=builder /m/packages ./packages

RUN chmod +x /app/packages/lsp/dist/index.js && \
    ln -s /app/packages/lsp/dist/index.js /usr/local/bin/luzzle-lsp

RUN mkdir -p /app/archive && \
    chgrp 0 /app /app/archive && \
    chmod g+w /app /app/archive

COPY --chown=:0 --chmod=775 packages/web/lsp/server.js ./
COPY --chown=:0 --chmod=775 packages/web/lsp/luzzle-lsp.js ./
COPY --chown=:0 --chmod=775 packages/web/lsp/markdownlint-lsp.js ./
COPY --chown=:0 --chmod=775 packages/web/lsp/package.json ./

EXPOSE 9001

CMD ["node", "/app/server.js"]
