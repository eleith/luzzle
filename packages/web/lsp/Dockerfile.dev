# Stage 1: Local package builder
FROM node:24-alpine AS lsp-builder
WORKDIR /local
COPY --from=lsp . /local/lsp
RUN cd /local/lsp && npm install && npm run build

# Stage 2: Dependency builder
FROM node:24-alpine AS builder
WORKDIR /app
COPY package.json ./
RUN npm install --omit=dev && npm cache clean --force

# Stage 3: Final runtime
FROM node:24-alpine
WORKDIR /app

RUN npm install -g yaml-language-server

COPY --from=lsp-builder /local/lsp/package.json /local/lsp/package.json
COPY --from=lsp-builder /local/lsp/dist /local/lsp/dist
COPY --from=lsp-builder /local/lsp/node_modules /local/lsp/node_modules

# npm install -g <local-path> symlinks the bin back to the source path,
# and the lsp package is ESM — ESM resolution walks from the script's
# real path looking for sibling node_modules, ignoring the global tree.
# Just COPY the deps next to dist and symlink the bin manually.
RUN chmod +x /local/lsp/dist/index.js && \
    ln -s /local/lsp/dist/index.js /usr/local/bin/luzzle-lsp

COPY --from=builder /app/node_modules ./node_modules

RUN mkdir -p /app/archive && \
    chgrp 0 /app /app/archive && \
    chmod g+w /app /app/archive

COPY --chown=:0 --chmod=775 ./server.js ./luzzle-lsp.js ./markdownlint-lsp.js ./package.json ./

EXPOSE 9001

CMD ["node", "/app/server.js"]
