{
	"name": "@luzzle/web.theme",
	"version": "0.0.1",
	"private": true,
	"author": "eleith",
	"scripts": {
		"lint": "eslint src",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest run --silent --coverage"
	},
	"engines": {
		"node": ">=24"
	},
	"files": [
		"dist/*",
		"assets/*",
		"package.json"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/eleith/luzzle.git"
	},
	"homepage": "https://github.com/eleith/luzzle",
	"description": "shared theme generator and canonical CSS for the luzzle web ecosystem",
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/src/index.d.ts",
			"import": "./dist/src/index.js"
		},
		"./styles/base.css": "./assets/styles/base.css",
		"./styles/reset.css": "./assets/styles/reset.css",
		"./styles/markdown.css": "./assets/styles/markdown.css"
	},
	"devDependencies": {
		"@eslint/js": "catalog:",
		"@types/eslint": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"globals": "catalog:",
		"prettier": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"dependencies": {
		"@luzzle/web.config": "workspace:*"
	},
	"type": "module"
}
