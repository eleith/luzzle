FROM node:24-alpine AS builder
WORKDIR /local

COPY --from=core . /local/core
COPY --from=utils . /local/utils
COPY --from=tools . /local/tools

RUN cd /local/core && npm install && npm run build
RUN cd /local/utils && npm install && npm run build
RUN cd /local/tools && \
    npm pkg set 'dependencies[@luzzle/core]'=file:/local/core && \
    npm pkg set 'dependencies[@luzzle/web.utils]'=file:/local/utils && \
    npm install && npm run build

FROM node:24-alpine

WORKDIR /app

ENV PUPPETEER_SKIP_DOWNLOAD=true

COPY --chown=:0 --chmod=777 package.json tsconfig.json svelte.config.js vite.config.ts eslint.config.js ./
COPY --chown=:0 --chmod=777 src ./src
COPY --chown=:0 --chmod=777 static ./static
COPY --chown=:0 --chmod=777 scripts ./scripts

COPY --from=builder /local/tools/package.json /local/tools/package.json
COPY --from=builder /local/tools/dist /local/tools/dist
COPY --from=builder /local/tools/node_modules /local/tools/node_modules
COPY --from=builder /local/core/package.json /local/core/package.json
COPY --from=builder /local/core/dist /local/core/dist
COPY --from=builder /local/core/node_modules /local/core/node_modules
COPY --from=builder /local/utils/package.json /local/utils/package.json
COPY --from=builder /local/utils/dist /local/utils/dist
COPY --from=builder /local/utils/node_modules /local/utils/node_modules

RUN npm pkg set 'dependencies[@luzzle/core]'=file:/local/core && \
    npm pkg set 'dependencies[@luzzle/web.utils]'=file:/local/utils && \
    npm pkg set 'devDependencies[@luzzle/web.tools]'=file:/local/tools

RUN rm -f package-lock.json && npm install --include dev \
	&& npm cache clean --force

RUN mkdir -p /app/assets/pieces /app/assets/build /app/data /app/content /app/build /app/node_modules/.cache /app/node_modules/.vite /app/.svelte-kit && \
    touch /app/config.yaml /app/.env && \
    chmod 777 /app /app/config.yaml /app/.env /app/package.json /app/package-lock.json && \
    chmod -R 777 /app/assets /app/data /app/content /app/build /app/node_modules/.cache /app/node_modules/.vite /app/.svelte-kit

EXPOSE 3000

ENTRYPOINT ["node", "scripts/manager.js"]
