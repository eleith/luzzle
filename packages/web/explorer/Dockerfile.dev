FROM node:24-alpine AS builder
WORKDIR /m

COPY package.json package-lock.json ./
COPY packages/ packages/

RUN npm ci --workspaces && \
    npm run build --workspace=@luzzle/core --workspace=@luzzle/web.config \
                   --workspace=@luzzle/web.utils --workspace=@luzzle/web.tools

FROM node:24-alpine
WORKDIR /app

ENV PUPPETEER_SKIP_DOWNLOAD=true

COPY --from=builder /m/node_modules /app/node_modules
COPY --from=builder /m/packages /app/packages

COPY --chown=:0 --chmod=777 packages/web/explorer/package.json /app/package.json
COPY --chown=:0 --chmod=777 packages/web/explorer/tsconfig.json /app/tsconfig.json
COPY --chown=:0 --chmod=777 packages/web/explorer/svelte.config.js /app/svelte.config.js
COPY --chown=:0 --chmod=777 packages/web/explorer/vite.config.ts /app/vite.config.ts
COPY --chown=:0 --chmod=777 packages/web/explorer/eslint.config.js /app/eslint.config.js
COPY --chown=:0 --chmod=777 packages/web/explorer/src /app/src
COPY --chown=:0 --chmod=777 packages/web/explorer/static /app/static
COPY --chown=:0 --chmod=777 packages/web/explorer/scripts /app/scripts

RUN npm install --include dev && npm cache clean --force

RUN mkdir -p /app/assets/pieces /app/assets/build /app/data /app/content /app/build /app/node_modules/.cache /app/node_modules/.vite /app/.svelte-kit && \
    touch /app/config.yaml /app/.env && \
    chmod 777 /app /app/config.yaml /app/.env /app/package.json && \
    chmod -R 777 /app/assets /app/data /app/content /app/build /app/node_modules/.cache /app/node_modules/.vite /app/.svelte-kit

EXPOSE 3000

ENTRYPOINT ["node", "scripts/manager.js"]
