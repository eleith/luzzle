FROM node:22-slim

WORKDIR /app

ENV PUPPETEER_SKIP_DOWNLOAD=true

COPY --chown=:0 package.json ./package.json

RUN --mount=type=secret,id=npmrc,target=/root/.npmrc npm install --include dev

RUN mkdir -p /app/src /app/static /app/scripts /app/assets /app/data /app/content /app/build /app/node_modules/.cache /app/.svelte-kit && \
    touch /app/config.yaml /app/.env && \
    chmod -R 777 /app

EXPOSE 5173

ENTRYPOINT ["sh", "-c", "npm run prebuild && npm run dev -- --host"]
