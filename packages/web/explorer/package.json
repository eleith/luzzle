{
  "name": "@luzzle/web",
  "version": "0.0.210",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm run sync:svelte && vite build",
    "prebuild": "pnpm run build:theme && pnpm run build:content",
    "predev": "pnpm run build:theme && pnpm run build:content",
    "build:theme": "node ./scripts/build-theme.js > src/lib/ui/styles/theme.build.css",
    "preview": "vite preview",
    "check": "pnpm run sync:svelte && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "pnpm run sync:svelte && svelte-check --tsconfig ./tsconfig.json --watch",
    "sync:content": "node ./scripts/sync-content.js && node ./scripts/sync-piece-content.js",
    "build:content": "pnpm run sync:content",
    "sync:svelte": "svelte-kit sync",
    "sync:worker": "node ./scripts/sync-worker-types.js",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run --silent"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eleith/luzzle.git"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@iconify-json/ph": "1.2.2",
    "@sveltejs/adapter-node": "5.3.2",
    "@sveltejs/enhanced-img": "0.8.1",
    "@sveltejs/kit": "2.43.0",
    "@sveltejs/vite-plugin-svelte": "6.2.0",
    "@types/eslint": "catalog:",
    "@types/mime-types": "^3.0.1",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-svelte": "3.9.3",
    "feedsmith": "2.1.0",
    "globals": "catalog:",
    "prettier-plugin-svelte": "3.3.2",
    "svelte": "5.39.4",
    "svelte-check": "4.3.2",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "unplugin-icons": "22.3.0",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.7.0"
  },
  "type": "module",
  "dependencies": {
    "@auth/core": "0.41.1",
    "@auth/sveltekit": "1.11.1",
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/lsp-client": "^6.2.2",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@luzzle/core": "0.0.59",
    "@luzzle/web.config": "workspace:*",
    "@luzzle/web.db": "workspace:*",
    "@luzzle/web.theme": "workspace:*",
    "@sidequest/core": "^1.15.0",
    "@sidequest/sqlite-backend": "^1.15.0",
    "bits-ui": "^2.17.2",
    "codemirror": "^6.0.2",
    "kysely": "0.28.17",
    "mime-types": "^3.0.2",
    "prettier": "catalog:",
    "remark": "15.0.1",
    "remark-lint": "^10.0.1",
    "remark-lint-heading-increment": "^4.0.1",
    "remark-lint-no-duplicate-headings": "^4.0.1",
    "remark-preset-lint-consistent": "^6.0.1",
    "remark-preset-lint-recommended": "^7.0.1",
    "sidequest": "^1.15.0",
    "takumi-js": "^1.3.0"
  }
}
