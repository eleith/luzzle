{
	"name": "@luzzle/web",
	"version": "0.0.161",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "npm run sync:svelte && vite build",
		"prebuild": "npm run build:theme && npm run sync:content",
		"predev": "npm run build:theme && npm run sync:content",
		"build:production": "npm run build && npm prune --omit=dev",
		"build:lock": "npm i --package-lock-only --workspaces=false",
		"build:theme": "luzzle-web-tools theme > src/lib/ui/styles/theme.build.css",
		"build:theme:minify": "luzzle-web-tools theme --minify > src/lib/ui/styles/theme.build.css",
		"preview": "vite preview",
		"check": "npm run prebuild && npm run sync:svelte && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "npm run sync:svelte && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:config": "luzzle-web-tools validate",
		"sync:content": "npm run sync:types && node ./scripts/sync-content.js && node ./scripts/sync-piece-content.js",
		"sync:types": "node ./scripts/set-piece-types.js",
		"sync:svelte": "svelte-kit sync",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"engines": {
		"node": ">=20"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/eleith/luzzle.git"
	},
	"devDependencies": {
		"@iconify-json/ph": "1.2.2",
		"@luzzle/web.tools": "0.0.106",
		"@sveltejs/adapter-node": "5.3.2",
		"@sveltejs/enhanced-img": "0.8.1",
		"@sveltejs/kit": "2.43.0",
		"@sveltejs/vite-plugin-svelte": "6.2.0",
		"@types/eslint": "9.6.1",
		"@types/mdast": "4.0.4",
		"@types/mime-types": "^3.0.1",
		"@types/node": "22.12.0",
		"@types/unist": "3.0.3",
		"eslint": "9.18.0",
		"eslint-config-prettier": "9.1.0",
		"eslint-plugin-svelte": "3.9.3",
		"feedsmith": "2.1.0",
		"globals": "15.14.0",
		"prettier": "3.4.2",
		"prettier-plugin-svelte": "3.3.2",
		"svelte": "5.39.4",
		"svelte-check": "4.3.2",
		"typescript": "5.7.3",
		"typescript-eslint": "8.19.1",
		"unplugin-icons": "22.3.0",
		"vite": "7.1.7",
		"yaml": "2.7.0"
	},
	"type": "module",
	"dependencies": {
		"@auth/core": "0.41.1",
		"@auth/sveltekit": "1.11.1",
		"@codemirror/lang-markdown": "^6.5.0",
		"@codemirror/lang-yaml": "^6.1.2",
		"@luzzle/core": "0.0.44",
		"@luzzle/web.utils": "0.0.29",
		"better-sqlite3": "11.7.2",
		"bits-ui": "2.14.1",
		"codemirror": "^6.0.2",
		"devlop": "1.1.0",
		"hastscript": "9.0.1",
		"kysely": "0.27.5",
		"mdast-util-from-markdown": "2.0.2",
		"mdast-util-gfm-autolink-literal": "2.0.1",
		"mdast-util-gfm-footnote": "2.1.0",
		"mdast-util-gfm-strikethrough": "2.0.0",
		"mdast-util-gfm-table": "2.0.0",
		"mdast-util-gfm-task-list-item": "2.0.0",
		"mdast-util-to-hast": "13.2.1",
		"mdast-util-to-markdown": "2.1.2",
		"mdast-util-to-string": "4.0.0",
		"micromark-core-commonmark": "2.0.3",
		"micromark-extension-gfm-autolink-literal": "2.1.0",
		"micromark-extension-gfm-footnote": "2.1.0",
		"micromark-extension-gfm-strikethrough": "2.1.0",
		"micromark-extension-gfm-table": "2.1.1",
		"micromark-extension-gfm-task-list-item": "2.1.0",
		"micromark-factory-space": "2.0.1",
		"micromark-util-character": "2.1.1",
		"micromark-util-normalize-identifier": "2.0.1",
		"micromark-util-symbol": "2.0.1",
		"micromark-util-types": "2.0.2",
		"mime-types": "^3.0.2",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-pretty-code": "^0.14.1",
		"rehype-raw": "^7.0.0",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
    "remark": "15.0.1",
		"remark-directive": "4.0.0",
		"remark-gemoji": "^8.0.0",
		"remark-lint": "^10.0.1",
		"remark-lint-heading-increment": "^4.0.1",
		"remark-lint-no-duplicate-headings": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-preset-lint-consistent": "^6.0.1",
		"remark-preset-lint-recommended": "^7.0.1",
		"remark-rehype": "^11.1.2",
		"shiki": "^3.22.0",
		"unified": "^11.0.5",
		"unist-util-visit": "5.0.0"
	}
}
