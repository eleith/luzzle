{
  "name": "@luzzle/web",
  "version": "0.0.210",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "npm run sync:svelte && vite build",
    "prebuild": "npm run build:theme && npm run sync:content",
    "predev": "npm run build:theme && npm run sync:content",
    "build:production": "npm run build && npm prune --omit=dev",
    "build:lock": "npm i --package-lock-only --workspaces=false",
    "build:theme": "luzzle-web-tools theme > src/lib/ui/styles/theme.build.css",
    "build:theme:minify": "luzzle-web-tools theme --minify > src/lib/ui/styles/theme.build.css",
    "preview": "vite preview",
    "check": "npm run sync:svelte && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "npm run sync:svelte && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:config": "luzzle-web-tools validate",
    "sync:content": "node ./scripts/sync-content.js && node ./scripts/sync-piece-content.js",
    "sync:svelte": "svelte-kit sync",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run --silent"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eleith/luzzle.git"
  },
  "devDependencies": {
    "@iconify-json/ph": "1.2.2",
    "@luzzle/web.tools": "0.0.129",
    "@sveltejs/adapter-node": "5.3.2",
    "@sveltejs/enhanced-img": "0.8.1",
    "@sveltejs/kit": "2.43.0",
    "@sveltejs/vite-plugin-svelte": "6.2.0",
    "@types/eslint": "9.6.1",
    "@types/mime-types": "^3.0.1",
    "@types/node": "22.12.0",
    "eslint": "9.18.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-svelte": "3.9.3",
    "feedsmith": "2.1.0",
    "globals": "15.14.0",
    "prettier-plugin-svelte": "3.3.2",
    "svelte": "5.39.4",
    "svelte-check": "4.3.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.19.1",
    "unplugin-icons": "22.3.0",
    "vite": "7.1.7",
    "vitest": "3.2.4",
    "yaml": "2.7.0"
  },
  "type": "module",
  "dependencies": {
    "@auth/core": "0.41.1",
    "@auth/sveltekit": "1.11.1",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/lsp-client": "^6.2.2",
    "@luzzle/core": "0.0.59",
    "@luzzle/web.config": "0.0.3",
    "@sidequest/sqlite-backend": "^1.15.0",
    "bits-ui": "^2.17.2",
    "codemirror": "^6.0.2",
    "kysely": "0.28.17",
    "mime-types": "^3.0.2",
    "prettier": "3.4.2",
    "remark": "15.0.1",
    "remark-lint": "^10.0.1",
    "remark-lint-heading-increment": "^4.0.1",
    "remark-lint-no-duplicate-headings": "^4.0.1",
    "remark-preset-lint-consistent": "^6.0.1",
    "remark-preset-lint-recommended": "^7.0.1",
    "sidequest": "^1.15.0"
  }
}
