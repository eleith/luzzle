{
	"name": "@luzzle/lsp",
	"version": "0.0.1",
	"author": "eleith",
	"description": "LSP proxy for YAML frontmatter validation in Luzzle markdown files",
	"scripts": {
		"lint": "eslint src",
		"build:executable": "chmod +x ./dist/index.js",
		"postbuild": "npm run build:executable",
		"build": "tsc",
		"test": "vitest run --coverage --silent"
	},
	"engines": {
		"node": ">=24"
	},
	"bin": {
		"luzzle-lsp": "./dist/index.js"
	},
	"files": [
		"dist/*",
		"package.json"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/eleith/luzzle.git"
	},
	"homepage": "https://github.com/eleith/luzzle",
	"devDependencies": {
		"@eslint/js": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"globals": "catalog:",
		"prettier": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"dependencies": {
		"vscode-jsonrpc": "^8.2.1"
	},
	"type": "module"
}
